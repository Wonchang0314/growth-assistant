{
  "name": "growth-assistant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "mcp": "node dist/mcp-stdio.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "nest build && node dist/migrate.js",
    "db:seed": "nest build && node dist/seed.js",
    "db:studio": "drizzle-kit studio",
    "sync": "nest build && node dist/sync.js",
    "extract": "nest build && node dist/extract.js",
    "abstract": "nest build && node dist/abstract.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "drizzle-orm": "0.45.3",
    "p-limit": "7.3.3",
    "pg": "8.23.1",
    "pino-roll": "4.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-fsrs": "5.4.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
