# 복사해서 .env로 만들고 값을 채운다. .env는 커밋하지 않는다.

# claude CLI 실행 파일 (PATH에 claude가 없을 때만)
# CLAUDE_EXECUTABLE=/path/to/claude

# PostgreSQL (docker compose와 애플리케이션이 함께 읽는다)
POSTGRES_HOST=localhost
# 다른 PostgreSQL이 5432를 쓰고 있으면 바꾼다 (예: 5433)
POSTGRES_PORT=5432
POSTGRES_DB=growth
POSTGRES_USER=growth
POSTGRES_PASSWORD=growth

# MCP Streamable HTTP 진입점 (npm run mcp:http). 127.0.0.1에만 바인딩하고 바깥에서는 터널로 닿는다
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3100

# OAuth 인가 서버 (MCP HTTP 진입점에 필요, docs/ops.md "OAuth"). 하나라도 없으면 HTTP 진입점이 시작하지 않는다
# 바깥에서 닿는 주소. MCP URL은 여기에 /mcp를 붙인다. 로컬 시험은 http://localhost:3100
# PUBLIC_BASE_URL=https://mcp.seok.app
# Google Cloud OAuth 클라이언트(웹). 리디렉트 URI는 <PUBLIC_BASE_URL>/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# 로그인을 허용할 구글 이메일 (쉼표 구분)
# OAUTH_ALLOWED_EMAILS=
# CIMD client_id URL로 받을 호스트 (쉼표 구분, 기본 claude.ai,chatgpt.com)
# OAUTH_CLIENT_ID_HOSTS=claude.ai,chatgpt.com

# 운영 알림 (docs/ops.md "운영 알림"). 없으면 로그만 남긴다
# ntfy 토픽 이름. 아는 사람은 누구나 구독할 수 있으니 추측하기 어렵게 짓는다
# NTFY_TOPIC=
# ntfy 서버 (기본 https://ntfy.sh)
# NTFY_URL=https://ntfy.sh

# Notion 수집 (npm run sync). MCP 서버만 쓸 때는 없어도 된다.
# 통합(Integration)의 Internal Integration Secret. 수집할 페이지에 통합을 연결(공유)해야 읽힌다
# NOTION_TOKEN=ntn_...
# 수집 루트 페이지·DB ID (쉼표 구분). 루트와 그 하위 전체를 모은다
# NOTION_ROOT_IDS=
