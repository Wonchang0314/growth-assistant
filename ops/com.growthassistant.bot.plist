<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  템플릿이다. ops/install.sh가 __PROJECT_DIR__, __NODE__, __NODE_DIR__, __HOME__을 채워 ~/Library/LaunchAgents/에 설치한다.
  작업 디렉터리를 프로젝트 루트로 두어야 .env를 읽는다. 실행 코드는 ops/deploy.sh가 만든 current 릴리스다.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.growthassistant.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>--enable-source-maps</string>
        <string>__HOME__/.growth-assistant/app/current/dist/main.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key>
        <string>production</string>
        <!-- 앱 로그를 이 디렉터리의 회전 파일에 쓴다 (current.log가 현재 파일). -->
        <key>LOG_DIR</key>
        <string>__HOME__/.growth-assistant/logs</string>
        <!-- launchd의 기본 PATH에는 node·claude가 없다. 그래도 claude를 못 찾으면 .env에 CLAUDE_EXECUTABLE을 넣는다. -->
        <key>PATH</key>
        <string>__NODE_DIR__:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 로그인하면 시작하고, 죽으면 다시 띄운다. DB가 아직 안 떠서 실패해도 30초 뒤 다시 시도한다. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- 로거가 뜨기 전에 난 오류(노드를 못 찾음, 릴리스 없음 등)만 여기에 남는다. -->
    <key>StandardOutPath</key>
    <string>__HOME__/.growth-assistant/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.growth-assistant/logs/launchd.err.log</string>
</dict>
</plist>
